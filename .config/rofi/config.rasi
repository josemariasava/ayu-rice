configuration {
    modi:                "drun,run,window";
    show-icons:          true;
    icon-theme:          "Papirus-Dark";
    drun-display-format: "{name}";
    display-drun:        " Apps";
    display-run:         " Run";
    display-window:      " Windows";
    terminal:            "kitty";
    font:                "JetBrainsMono Nerd Font 12";
}

/* Active palette (symlink to colors-mirage.rasi / colors-light.rasi) */
@import "colors.rasi"

/* Only alias names that differ from colors.rasi. Do NOT redefine accent/muted/
   surface here as `accent: @accent;` — that is self-referential and makes rofi
   throw "variable failed to resolve" on every launch. */
* {
    foreground: @fg;
}

window {
    transparency:     "real";
    location:         center;
    anchor:           center;
    width:            560px;
    border-radius:    16px;
    background-color: @bg;
    border:           2px;
    border-color:     @accent;
    padding:          0;
}

mainbox { padding: 16px; spacing: 12px; }

inputbar {
    background-color: @surface;
    text-color:       @foreground;
    border-radius:    12px;
    padding:          12px 16px;
    spacing:          10px;
    children:         [ prompt, entry ];
}

prompt { text-color: @accent; }
entry  { placeholder: "Search…"; placeholder-color: @muted; }

listview {
    lines:        8;
    columns:      1;
    scrollbar:    false;
    spacing:      4px;
    padding:      4px 0px;
}

element {
    padding:       10px 14px;
    border-radius: 10px;
    spacing:       12px;
    text-color:    @foreground;
}
element selected {
    background-color: @accent;
    text-color:       @bg;
}
element-icon { size: 1.1em; vertical-align: 0.5; }
element-text { vertical-align: 0.5; }

mode-switcher { spacing: 8px; }
button { padding: 8px; border-radius: 10px; text-color: @muted; }
button selected { background-color: @surface; text-color: @accent; }
